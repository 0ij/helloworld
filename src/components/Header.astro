---
import { SITE_GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<header>
	<nav>
		<div class="brand">
			<p class="eyebrow">Engineering Blog</p>
			<h2><a href={baseUrl}>{SITE_TITLE}</a></h2>
		</div>
		<div class="internal-links">
			<HeaderLink href={baseUrl}>首页</HeaderLink>
			<HeaderLink href={`${baseUrl}blog/`}>文章</HeaderLink>
			<HeaderLink href={`${baseUrl}thoughts/`}>思考</HeaderLink>
			<HeaderLink href={`${baseUrl}about/`}>关于</HeaderLink>
		</div>
		<div class="actions">
			<a href={SITE_GITHUB_URL} class="github-link" target="_blank" rel="noreferrer">
				<svg class="github-link__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path
						fill="currentColor"
						d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.113.825-.258.825-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.775.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.225.694.825.577C20.565 21.795 24 17.31 24 12c0-6.63-5.37-12-12-12z"
					/>
				</svg>
				<span>GitHub</span>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 1rem 1.25rem;
		backdrop-filter: blur(16px);
		background: rgba(255, 250, 244, 0.84);
		border-bottom: 1px solid rgba(45, 73, 88, 0.12);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1120px;
		margin: 0 auto;
	}

	.brand {
		display: grid;
		gap: 0.1rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgb(var(--muted));
	}

	h2 {
		margin: 0;
		font-size: 1.1rem;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--ink));
	}

	.internal-links,
	.actions {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}

	nav a {
		padding: 0.5rem 0;
		color: rgb(var(--ink));
		text-decoration: none;
	}

	.github-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 0.85rem 0.5rem 0.75rem;
		border-radius: 999px;
		font-size: 0.88rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: rgb(var(--ink));
		text-decoration: none;
		background: rgba(var(--ink), 0.04);
		border: 1px solid rgba(var(--ink), 0.12);
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset;
		transition:
			transform 180ms ease,
			background 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease;
	}

	.github-link:hover {
		transform: translateY(-1px);
		background: rgba(var(--ink), 0.07);
		border-color: rgba(var(--ink), 0.2);
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.75) inset;
	}

	.github-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.github-link__icon {
		width: 1.1em;
		height: 1.1em;
		flex-shrink: 0;
		opacity: 0.92;
	}

	@media (max-width: 820px) {
		nav {
			flex-wrap: wrap;
		}

		.actions {
			width: 100%;
		}
	}

	@media (max-width: 560px) {
		header {
			padding: 0.9rem 1rem;
		}

		.internal-links,
		.actions {
			flex-wrap: wrap;
		}
	}
</style>
