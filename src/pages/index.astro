---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import ThoughtCard from '../components/ThoughtCard.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter(({ data }) => !data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const thoughts = (await getCollection('thoughts'))
	.filter(({ data }) => !data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = posts.slice(0, 3);
const latestThoughts = thoughts.slice(0, 2);
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.9fr);
				gap: 1.2rem;
				align-items: stretch;
			}

			.hero-panel,
			.status-panel {
				padding: clamp(1.4rem, 4vw, 2rem);
				border-radius: 32px;
				border: 1px solid rgba(45, 73, 88, 0.12);
				background: rgba(255, 252, 247, 0.88);
				box-shadow: 0 24px 56px rgba(45, 73, 88, 0.1);
				animation: rise 600ms ease both;
			}

			.hero-panel {
				background:
					radial-gradient(circle at top right, rgba(38, 116, 108, 0.16), transparent 30%),
					linear-gradient(180deg, rgba(255, 253, 249, 0.94), rgba(248, 241, 231, 0.96));
			}

			.eyebrow {
				margin: 0;
				font-size: 0.8rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent-strong);
			}

			h1 {
				max-width: 12ch;
				margin-top: 0.8rem;
				margin-bottom: 1rem;
			}

			.lead {
				max-width: 60ch;
				font-size: 1.08rem;
				color: rgb(var(--muted-strong));
			}

			.hero-actions,
			.stack,
			.post-grid,
			.flow-list {
				padding: 0;
				list-style: none;
			}

			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.9rem;
				margin-top: 1.6rem;
			}

			.hero-actions a {
				display: inline-flex;
				align-items: center;
				padding: 0.8rem 1.15rem;
				border-radius: 999px;
				text-decoration: none;
				font-weight: 600;
			}

			.hero-actions .primary {
				background: linear-gradient(135deg, var(--accent), #1f8a81);
				color: white;
			}

			.hero-actions .secondary {
				background: rgba(38, 116, 108, 0.08);
				color: var(--accent-strong);
			}

			.section-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin-top: 4rem;
				margin-bottom: 1.2rem;
			}

			.section-head h2,
			.section-head p {
				margin: 0;
			}

			.post-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}

			.stack {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
				margin-top: 1.25rem;
			}

			.stack li,
			.flow-list li {
				padding: 1.1rem 1.2rem;
				border-radius: 24px;
				border: 1px solid rgba(45, 73, 88, 0.1);
				background: rgba(255, 255, 255, 0.68);
			}

			.stack strong,
			.flow-list strong {
				display: block;
				margin-bottom: 0.45rem;
				color: rgb(var(--ink));
			}

			.status-panel h2,
			.status-panel p {
				margin: 0;
			}

			.status-panel h2 {
				margin-top: 0.35rem;
			}

			.flow-list {
				display: grid;
				gap: 0.8rem;
				margin-top: 1rem;
			}

			@keyframes rise {
				from {
					opacity: 0;
					transform: translateY(12px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.hero-panel,
				.status-panel {
					animation: none;
				}
			}

			@media (max-width: 920px) {
				.hero,
				.post-grid,
				.stack {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-panel">
					<p class="eyebrow">Notes In Public</p>
					<h1>把搭建过程、工具链经验和底层原理写成可以长期复用的笔记</h1>
					<p class="lead">
						这里记录我在前端工程、AI Agent、自托管工具和 React 原理上的学习过程。
						内容会尽量从“为什么这样设计”写到“具体怎么落地”。
					</p>
					<ul class="hero-actions">
						<li><a class="primary" href={`${baseUrl}blog/`}>阅读文章</a></li>
						<li><a class="secondary" href={`${baseUrl}about/`}>查看站点说明</a></li>
					</ul>
				</div>
				<aside class="status-panel">
					<p class="eyebrow">Current Focus</p>
					<h2>最近集中整理这三条主线</h2>
					<ul class="flow-list">
						<li><strong>工程化</strong> 记录如何用 Astro、GitHub Actions、GitHub Pages 搭站并稳定发布。</li>
						<li><strong>AI Agent</strong> 梳理 OpenClaw 的能力边界、部署路径和渠道接入方式。</li>
						<li><strong>React</strong> 从 Fiber 出发理解 React 16 到 React 18 的更新模型演进。</li>
					</ul>
				</aside>
			</section>

			<section>
				<div class="section-head">
					<div>
						<p class="eyebrow">Latest Posts</p>
						<h2>最近更新</h2>
					</div>
					<a href={`${baseUrl}blog/`}>查看全部</a>
				</div>
				<ul class="post-grid">
					{latestPosts.map((post, index) => <li><PostCard post={post} featured={index === 0} /></li>)}
				</ul>
			</section>

			<section>
				<div class="section-head">
					<div>
						<p class="eyebrow">Thinking Track</p>
						<h2>思考栏目</h2>
					</div>
					<a href={`${baseUrl}thoughts/`}>查看栏目</a>
				</div>
				{
					latestThoughts.length > 0 ? (
						<ul class="post-grid">
							{latestThoughts.map((thought, index) => <li><ThoughtCard thought={thought} featured={index === 0} /></li>)}
						</ul>
					) : (
						<ul class="stack">
							<li>
								<strong>独立栏目已开出</strong>
								后续可以在 <code>src/content/thoughts/</code> 下新增内容，用来记录随笔以外的判断、方法和观察。
							</li>
						</ul>
					)
				}
			</section>

			<section>
				<div class="section-head">
					<div>
						<p class="eyebrow">How I Write</p>
						<h2>我希望这些文章能解决的问题</h2>
					</div>
				</div>
				<ul class="stack">
					<li>
						<strong>从零到一</strong>
						不仅给结论，也会把初始化、配置和踩坑路径写清楚。
					</li>
					<li>
						<strong>能落到代码和命令</strong>
						尽量给出明确命令、配置片段和验证方法，而不是只停留在概念层面。
					</li>
					<li>
						<strong>重视演进过程</strong>
						尤其是 React 这类框架，很多机制要放到版本演进里看才容易理解。
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
