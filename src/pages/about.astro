---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_EMAIL, SITE_GITHUB_URL } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="关于" description={SITE_DESCRIPTION} />
		<style>
			main {
				display: grid;
				grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
				gap: 1rem;
			}

			.panel {
				padding: 1.8rem;
				border-radius: 30px;
				border: 1px solid rgba(45, 73, 88, 0.1);
				background: rgba(255, 255, 255, 0.84);
				box-shadow: 0 18px 48px rgba(45, 73, 88, 0.08);
			}

			.panel h1,
			.panel h2,
			.panel p {
				margin-top: 0;
			}

			.panel h2 {
				margin-bottom: 0.75rem;
				font-size: 1.2rem;
			}

			.panel p:last-child {
				margin-bottom: 0;
			}

			.list {
				padding-left: 1.2rem;
				margin-bottom: 0;
			}

			.contact {
				display: grid;
				gap: 0.8rem;
			}

			.contact a {
				text-decoration: none;
			}

			@media (max-width: 920px) {
				main {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="panel">
				<h1>关于这个博客</h1>
				<p>
					这个站点本身就是一份长期维护中的工程笔记。我希望它既能记录结论，
					也能把初始化过程、配置细节、踩坑点和版本差异一并留下来。
				</p>
				<p>
					目前内容主要聚焦在前端工程、GitHub 工作流、AI Agent 自托管和 React 原理。
					后续也会逐步加入更多偏实践的复盘文章。
				</p>
				<h2>我希望文章保持的写法</h2>
				<ul class="list">
					<li>先解释问题背景，再展开实际方案和配置步骤。</li>
					<li>尽量给出可执行命令和配置，而不是只讲概念。</li>
					<li>遇到版本演进时，把旧机制和新机制放在一起比较。</li>
				</ul>
			</section>
			<aside class="panel">
				<h2>站点维护者</h2>
				<p>{SITE_AUTHOR}</p>
				<div class="contact">
					<a href={SITE_GITHUB_URL} target="_blank" rel="noreferrer">GitHub 仓库</a>
					<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
				</div>
			</aside>
		</main>
		<Footer />
	</body>
</html>
